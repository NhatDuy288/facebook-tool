{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true, "noEmit": true, "strict": true,
    "allowJs": true, "checkJs": false, "skipLibCheck": true,
    "types": ["node"], "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*.ts"]
}
